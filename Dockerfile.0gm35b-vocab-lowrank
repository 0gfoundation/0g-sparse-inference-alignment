# Dockerfile for 0GM-35B SIA b2 inproc with vocab_lowrank head VM (FaRMA).
#
# Same base as Dockerfile.0gm35b (vllm 0.18.0) with two additions:
#   1. Token mapping table (token_mapping_ogm35b_to_qwen3_4b.npy) baked in at /opt/token_mapping/
#   2. CMD uses --vm_head_type vocab_lowrank and --mapping_table flags
#
# Source code and model weights are NOT baked in — bind-mount at runtime.
# Assumed runtime layout:
#   /workspace/models/                                      <- model weights mount
#       0GM-1.0-35B-A3B/
#       VM-Qwen3-4B-vocab-lowrank-merged/
#   /workspace/sia-repo/0g-sparse-inference-alignment/     <- repo mount
#
# Build:
#   docker build -f Dockerfile.0gm35b-vocab-lowrank -t sia-0gm35b-vocab-lowrank:0.18.0 .
#
# Run:
#   docker run -it --rm --gpus all --shm-size=16g --ipc=host \
#     -p 8000:8000 \
#     -v /dstack/persistent/SIA:/workspace \
#     sia-0gm35b-vocab-lowrank:0.18.0 bash

FROM pytorch/pytorch:2.11.0-cuda12.8-cudnn9-devel

# ---- System dependencies -----------------------------------------------
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      ca-certificates curl python3.12-venv && \
    rm -rf /var/lib/apt/lists/*

# ---- Create venv with all heavy Python deps ----------------------------
ENV VENV_PATH=/opt/venv-0gm35b
ENV VIRTUAL_ENV=${VENV_PATH}
ENV PATH=${VENV_PATH}/bin:${PATH}

COPY requirements/ /tmp/requirements/

RUN python3 -m venv ${VENV_PATH} && \
    ${VENV_PATH}/bin/pip install --upgrade --no-cache-dir pip wheel && \
    ${VENV_PATH}/bin/pip install --no-cache-dir -r /tmp/requirements/0gm35b-b2-inproc.txt && \
    rm -rf /tmp/requirements

# ---- Bake in token mapping table ---------------------------------------
# Eliminates decode→encode text round-trip for cross-tokenizer vocab_lowrank scoring.
COPY token_mapping_ogm35b_to_qwen3_4b.npy /opt/token_mapping/token_mapping_ogm35b_to_qwen3_4b.npy

# ---- Entrypoint: register sia_rm vllm plugin against the mounted repo --
COPY scripts/docker_entrypoint_0gm35b_vocab_lowrank.sh /usr/local/bin/sia-entrypoint
RUN chmod +x /usr/local/bin/sia-entrypoint

WORKDIR /workspace/sia-repo/0g-sparse-inference-alignment

# SIA_RM_CUDAGRAPH=none: required for 0GM-35B b2 inproc (runtime CUDAGraph capture conflicts).
ENV SIA_RM_CUDAGRAPH=none
ENV SIA_RM_MULTIPROCESS=0

ENTRYPOINT ["/usr/local/bin/sia-entrypoint"]
CMD ["python", "src/sia_vllm_server.py", \
     "--llm",              "/workspace/models/0GM-1.0-35B-A3B", \
     "--rm_backend",       "b2", \
     "--rm_model",         "/workspace/models/VM-Qwen3-4B-vocab-lowrank-merged", \
     "--llm_gpu_mem",      "0.75", \
     "--rm_b2_gpu_mem",    "0.13", \
     "--topk",             "10", \
     "--weight",           "1.0", \
     "--entropy_threshold","1.0", \
     "--max_model_len",    "2048", \
     "--mamba_cache_mode", "align", \
     "--vm_head_type",     "vocab_lowrank", \
     "--mapping_table",    "/opt/token_mapping/token_mapping_ogm35b_to_qwen3_4b.npy", \
     "--host",             "0.0.0.0", \
     "--port",             "8000"]
